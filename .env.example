# Copier ce fichier en .env puis remplir les valeurs.
# .env n'est JAMAIS commité.

# --- IA (NVIDIA NIM) ---
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=

# --- SIEM / XDR ---
SIEM_ADMIN_USER=admin
SIEM_ADMIN_PASSWORD=changez-moi

# --- Machines cibles du labo ---
TARGET_SSH_USER=labuser
TARGET_SSH_PASSWORD=changez-moi

# --- Réseau du labo ---
LAB_SUBNET=172.30.0.0/24
